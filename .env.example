LETTERBOXD_USERNAME=Jmackwell

# Sarah's Letterboxd username — shown additively in her own dashboard tab.
# Optional: the feature no-ops entirely if left unset.
SARAH_LETTERBOXD_USERNAME=

# Postgres connection string (e.g. from a free Neon or Supabase project) —
# this is where all watchlist/diary/discovery state now lives.
DATABASE_URL=

# TMDB (themoviedb.org) — used for --similar-to. Get a free API key under
# Settings -> API -> "API Key (v3 auth)".
TMDB_API_KEY=

# Resend (resend.com) — used for email notifications.
RESEND_API_KEY=
NOTIFY_EMAIL=you@example.com
